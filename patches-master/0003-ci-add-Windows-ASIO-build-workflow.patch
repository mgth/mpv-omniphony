From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mathieu GRENET <mathieu@mgth.fr>
Date: Tue, 26 May 2026 14:58:45 +0200
Subject: [PATCH 03/28] ci: add Windows ASIO build workflow

Add a dedicated GitHub Actions workflow that builds the ASIO-enabled
mpv on Windows under MSYS2 UCRT64. The existing build.yml only fires
on master, so a separate workflow is needed for this branch.

The workflow:

- Triggers on push to main, PRs targeting main, and manual dispatch.
- Sets up MSYS2 UCRT64 with the same pacboy package set as the
  upstream msys2 job in build.yml.
- Configures meson with -Dasio=enabled and fails fast if the meson
  configuration does not report `asio : enabled`.
- Builds with meson compile and prints the meson log on failure.
- Smoke-tests the resulting binary by running `mpv --version` and
  checking that `--ao=help` lists `asio`.
- Uploads mpv.exe / mpv.com / libmpv-2.dll as the
  `mpv-windows-ucrt64-asio` artifact.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 .github/workflows/build-windows-asio.yml | 113 +++++++++++++++++++++++
 1 file changed, 113 insertions(+)
 create mode 100644 .github/workflows/build-windows-asio.yml

diff --git a/.github/workflows/build-windows-asio.yml b/.github/workflows/build-windows-asio.yml
new file mode 100644
index 0000000000..4b64303115
--- /dev/null
+++ b/.github/workflows/build-windows-asio.yml
@@ -0,0 +1,113 @@
+name: build-windows-asio
+
+on:
+  push:
+    branches: [main]
+    paths-ignore:
+      - 'DOCS/**'
+      - 'TOOLS/lua/**'
+      - '.editorconfig'
+      - '.github/ISSUE_TEMPLATE/**'
+      - '.github/PULL_REQUEST_TEMPLATE'
+      - '.gitignore'
+      - 'Copyright'
+      - 'README.md'
+      - 'RELEASE_NOTES'
+  pull_request:
+    branches: [main]
+    paths-ignore:
+      - 'DOCS/**'
+      - 'TOOLS/lua/**'
+      - '.editorconfig'
+      - '.github/ISSUE_TEMPLATE/**'
+      - '.github/PULL_REQUEST_TEMPLATE'
+      - '.gitignore'
+      - 'Copyright'
+      - 'README.md'
+      - 'RELEASE_NOTES'
+  workflow_dispatch:
+
+jobs:
+  msys2-ucrt64:
+    runs-on: windows-latest
+    defaults:
+      run:
+        shell: msys2 {0}
+    steps:
+      - name: Disable autocrlf
+        shell: pwsh
+        run: |
+          git config --global core.autocrlf false
+          git config --global core.eol lf
+
+      - uses: actions/checkout@v6
+
+      - uses: msys2/setup-msys2@v2
+        with:
+          msystem: ucrt64
+          update: true
+          install: git
+          pacboy: >-
+            ca-certificates:p
+            cc:p
+            ffmpeg:p
+            lcms2:p
+            libarchive:p
+            libass:p
+            libjpeg-turbo:p
+            libplacebo:p
+            luajit:p
+            meson:p
+            ninja:p
+            pkgconf:p
+            python:p
+            rubberband:p
+            shaderc:p
+            spirv-cross:p
+            uchardet:p
+            vapoursynth:p
+            vulkan-devel:p
+
+      - name: Configure meson with ASIO enabled
+        id: setup
+        run: |
+          meson setup _build -Dasio=enabled
+
+      - name: Verify ASIO feature is enabled
+        run: |
+          if ! grep -E -q "^[[:space:]]*asio[[:space:]]*:[[:space:]]*enabled" _build/meson-logs/meson-log.txt; then
+            echo "ERROR: 'asio' feature is not enabled in the meson configuration"
+            echo "----- meson-log.txt (last 200 lines) -----"
+            tail -n 200 _build/meson-logs/meson-log.txt
+            exit 1
+          fi
+          echo "OK: 'asio' feature is enabled"
+
+      - name: Build
+        id: build
+        run: |
+          meson compile -C _build
+
+      - name: Print meson log on failure
+        if: ${{ failure() && (steps.setup.outcome == 'failure' || steps.build.outcome == 'failure') }}
+        run: |
+          cat _build/meson-logs/meson-log.txt
+
+      - name: Smoke test - print mpv version
+        run: |
+          ./_build/mpv.com --no-config --version
+
+      - name: Smoke test - asio appears in --ao=help
+        run: |
+          out=$(./_build/mpv.com --no-config --ao=help)
+          echo "$out"
+          echo "$out" | grep -E '^[[:space:]]*asio[[:space:]]' >/dev/null || { echo "ERROR: asio AO not listed by --ao=help"; exit 1; }
+          echo "OK: asio AO is registered"
+
+      - uses: actions/upload-artifact@v5
+        with:
+          name: mpv-windows-ucrt64-asio
+          path: |
+            _build/mpv.exe
+            _build/mpv.com
+            _build/libmpv-2.dll
