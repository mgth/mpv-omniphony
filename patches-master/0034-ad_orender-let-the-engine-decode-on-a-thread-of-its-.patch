@@ -262,7 +262,7 @@ void orender_reset(struct OrenderRenderer *r);
 int orender_process(struct OrenderRenderer *r,
                     const uint8_t *pkt,
                     uintptr_t pkt_len,
-                    int64_t _pts_us,
+                    int64_t pts_us,
