# Maintainer: Mathieu Grenet <mathieu@mgth.fr>
#
# mpv-omniphony-git — mpv master HEAD built with the ad_orender spatial audio
# decoder (liborender). Live tracker of upstream mpv master; not for stable
# distribution. Coexists conflict-wise with `mpv-omniphony` (the pinned
# v0.41.0 build) — install one or the other.
#
# Built from a checkout of this repository: the tag of the fork's
# `orender-master` branch pinned in ../mpv-fork.env is merged into mpv master
# HEAD, as scripts/mpv-source.sh master does. A merge conflict means mpv
# master has moved under the fork's commits (README, "Tracking mpv master").

pkgname=mpv-omniphony-git
_mpvver=master
pkgver=r0.0000000           # overwritten by pkgver() at build time
pkgrel=1
pkgdesc="mpv master + orender spatial audio decoder (HEAD; tracks upstream)"
arch=('x86_64')
url="https://github.com/mgth/mpv-omniphony"
license=('GPL-3.0-or-later')
depends=('orender>=0.4.1' 'ffmpeg' 'libass' 'libplacebo' 'lua' 'libx11' 'mesa')
makedepends=('meson' 'ninja' 'python' 'git')
provides=('mpv' 'mpv-omniphony' 'libmpv.so')
conflicts=('mpv' 'mpv-omniphony')
# MPV_FORK_URL, MPV_UPSTREAM_URL and MPV_FORK_MASTER_TAG.
. "$(dirname "${BASH_SOURCE[0]}")/../mpv-fork.env"

source=("mpv::git+$MPV_UPSTREAM_URL#branch=master"
        "mpv-fork::git+$MPV_FORK_URL#tag=$MPV_FORK_MASTER_TAG")
sha256sums=('SKIP'
            'SKIP')

pkgver() {
    cd "$srcdir/mpv"
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$srcdir/mpv"
    git fetch --quiet --no-tags "$srcdir/mpv-fork" HEAD
    git -c user.name=makepkg -c user.email=makepkg@localhost \
        merge --quiet --no-edit FETCH_HEAD
}

build() {
    cd "$srcdir/mpv"
    arch-meson build -Dorender=enabled
    meson compile -C build
}

package() {
    cd "$srcdir/mpv"
    meson install -C build --destdir="$pkgdir"
}
