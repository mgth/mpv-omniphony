+         "lmspq = pow(max(lmspq, 0.0), vec3(%f));   \n"
+         "lmspq = (vec3(%f) + %f * lmspq)           \n"
+         "        / (vec3(1.0) + %f * lmspq);       \n"
+         "lmspq = pow(lmspq, vec3(%f));             \n"
+         "%s""ipt = "$" * lmspq;                    \n",
+         v, rgb2lms,
+         v, PL_COLOR_SDR_WHITE / 10000,
