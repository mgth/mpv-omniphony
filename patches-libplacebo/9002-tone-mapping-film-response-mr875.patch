+        tm_o = pow(max(tm_o - ${const float: PQ_C1}, 0.0) /                 \
+                   (${const float: PQ_C2} - ${const float: PQ_C3} * tm_o),  \
+                   vec3(1.0 / ${const float: PQ_M1}));                      \
