# Where the builds take mpv from: tags of the fork, https://github.com/mgth/mpv.
# Sourced by scripts/mpv-source.sh and scripts/export-patches.sh; this file is
# the only place a build's mpv source is named.
#
# A fork tag is never moved. To ship a change of the fork, tag the new head
# (orender-v<player version>, then orender-v<player version>.1, .2, ...; the
# same with orender-master-v...) and update the tag and its commit here. The
# scripts refuse a tag that does not resolve to the commit recorded next to it.

MPV_FORK_URL=https://github.com/mgth/mpv.git
MPV_UPSTREAM_URL=https://github.com/mpv-player/mpv.git

# Stable track: the fork's `orender` branch, on the upstream release MPV_TAG.
MPV_TAG=v0.41.0
MPV_FORK_STABLE_TAG=orender-v0.7.0.1
MPV_FORK_STABLE_SHA=e006f5ca04a1f6c3838ef6e683993eb596c6065a

# Master track: the fork's `orender-master` branch, on the upstream master
# commit MPV_MASTER_BASE.
MPV_MASTER_BASE=413ff0b1cd4585294803308a1a14be2fad30cede
MPV_FORK_MASTER_TAG=orender-master-v0.7.0.1
MPV_FORK_MASTER_SHA=e4ef2fb55c17954fe564ca83f40091d8000b4518
