 player/core.h            |   3 +
 player/main.c            |   4 +
 player/orender_overlay.c | 386 +++++++++++++++++++++++++++++++++++++++
 4 files changed, 395 insertions(+), 1 deletion(-)
 create mode 100644 player/orender_overlay.c

